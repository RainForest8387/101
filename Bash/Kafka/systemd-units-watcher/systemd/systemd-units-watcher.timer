# /etc/systemd/system/systemd-units-watcher.timer
#
# Расписание: вторник и пятница, каждые 15 минут в период с 04:00 до 09:00.
# Итого 21 срабатывание за день: 04:00, 04:15, ... 08:45, 09:00.
#
# Включение:
#   systemctl daemon-reload
#   systemctl enable --now systemd-units-watcher.timer
# Проверка расписания:
#   systemctl list-timers systemd-units-watcher.timer
#   systemd-analyze calendar 'Tue,Fri *-*-* 04..08:00/15:00' --iterations=8

[Unit]
Description=Таймер watchdog'а Kafka-стека (вт и пт, 04:00-09:00, каждые 15 минут)

[Timer]
Unit=systemd-units-watcher.service

# Основное окно: часы 04..08, минуты 00/15/30/45
OnCalendar=Tue,Fri *-*-* 04..08:00/15:00
# Закрывающая точка ровно в 09:00 (иначе окно обрывалось бы на 08:45)
OnCalendar=Tue,Fri *-*-* 09:00:00

# Срабатывать точно в минуту, а не «в течение минуты» (по умолчанию AccuracySec=1min)
AccuracySec=1s
# Разброс не нужен: проверка дешёвая и должна идти по сетке
RandomizedDelaySec=0
# Догоняем пропущенное: если хост был выключен во время окна, после загрузки
# таймер сработает один раз (не 21) и проверит, что сервисы поднялись.
# systemd хранит отметку последнего запуска в
#   /var/lib/systemd/timers/stamp-systemd-units-watcher.timer
# ВНИМАНИЕ: догоняющий запуск происходит сразу после загрузки, независимо от
# времени суток и дня недели — хост, включённый в субботу в 14:00, получит
# проверку в 14:00. Для watchdog'а это ровно то поведение, что нужно.
# При самом первом enable отметки ещё нет — базой становится момент включения
# таймера, так что немедленного «догоняющего» срабатывания не будет.
Persistent=true

[Install]
WantedBy=timers.target
